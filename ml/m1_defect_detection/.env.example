# Copy to .env and fill your key (never commit .env — it is gitignored via root .gitignore)
# Build.nvidia.com free hosted NIM — https://build.nvidia.com/meta/llama-3.2-11b-vision-instruct
# Used only for the one-sentence description (assess_device --describe). The detector never
# uses NIM for a verdict; missing key falls back to a local template automatically.
NVAPI_KEY=nvapi-...
# Alternative names also read: NVIDIA_API_KEY, NIM_API_KEY

# Optional overrides for the real VisionProvider (backend use)
# VISION_PROVIDER=real
# ML_WEIGHTS_DIR=/home/irahu/safresale-ml/m1/runs/improved-yolo11n-4/weights/best.pt